# Monolithic Application Configurations
DATABASE_URL=sqlite+aiosqlite:///data/inventory.db
PORT=3000
ENVIRONMENT=development

# JWT Security Configuration
JWT_SECRET=8f4a7c2e9b0d1e3f5a6b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Seeding Options
DB_CREATE_TABLES=False
DB_OVERWRITE_TABLES=False

# Global Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Email & SMTP Alert Configuration
# Set EMAIL_ENABLED=False to disable all email dispatches globally
EMAIL_ENABLED=True
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@inventory.com

# Docker & Load Balancer Configurations
# Set ENABLE_APACHE=true to route all port 80 traffic through Apache reverse proxy balancer
ENABLE_APACHE=false
APACHE_PORT=80
